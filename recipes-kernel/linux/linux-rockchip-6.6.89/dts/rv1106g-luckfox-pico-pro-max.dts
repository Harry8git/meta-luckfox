/**********NPU**********/
//&npu {
//	assigned-clock-rates = <700000000>;
//};

/**********FLASH**********/
&sfc {
	status = "okay";
	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <75000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <1>;
	};
};

/**********SDMMC**********/
&sdmmc {
	max-freqency = <50000000>;
	no-mmc;
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;

	//sdio
	cap-sdio-irq;
	non-removable;
	no-1-8-v;
	supports-sdio;

	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_clk &sdmmc0_cmd &sdmmc0_det &sdmmc0_bus4>;
	status = "okay";
};

/**********ETH**********/
&gmac {
	/*
	 * The Rockchip vendor-storage MTD (SPI NAND) does not probe on this
	 * board (SFC reports raw ID 0x0000000000), and the OE wic/SD layout has
	 * no ENVF env block, so U-Boot cannot supply a persistent ethaddr and the
	 * kernel falls back to a random MAC on every boot. Pin a stable
	 * locally-administered address (bit 1 of the first octet set) until the
	 * vendor-storage / ENVF path is fixed. Change per board if several run on
	 * the same LAN.
	 */
	local-mac-address = [02 be ef 11 06 01];
	status = "okay";
};

/*
 * On kernel 6.6 the integrated RV1106 FEPHY links at 100 Mbps but large frames
 * are corrupted on the wire (small packets and 10 Mbps are fine), so force the
 * link to 10 Mbps where RMII signalling is far more tolerant. Ethernet and SSH
 * are reliable at 10 Mbps. Remove this override to attempt 100 Mbps again.
 */
&rmii_phy {
	max-speed = <10>;
};

/**********USB**********/
&u2phy {
	status = "okay";
};

&u2phy_otg {
	rockchip,dis-u2-susphy;
	status = "okay";
};

&usbdrd {
	status = "okay";
};

&usbdrd_dwc3 {
	status = "okay";
	dr_mode = "peripheral";
};

/**********SPI**********/
&spi0 {
	status = "disabled";
	spidev@0 {
		spi-max-frequency = <50000000>;
	};
	fbtft@0 {
		spi-max-frequency = <50000000>;
	};
};

/**********I2C**********/
/* I2C3_M1 */
&i2c3 {
	status = "disabled";
	clock-frequency = <100000>;
};

/* I2C1_M1 */
&i2c1 {
	status = "disabled";
	clock-frequency = <100000>;
};


/**********UART**********/
/* UART3_M1 */
&uart3 {
	status = "disabled";
};

/* UART4_M1 */
&uart4 {
	status = "disabled";
};

/**********RTC**********/
&rtc {
	status = "okay";
};
