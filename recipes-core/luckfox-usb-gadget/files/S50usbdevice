#!/bin/sh

ACM_EN=on
NCM_EN=on

USB_ATTRIBUTE=0x409
USB_GROUP=rockchip
USB_SKELETON=b.1

CONFIGFS_DIR=/sys/kernel/config
USB_CONFIGFS_DIR=${CONFIGFS_DIR}/usb_gadget/${USB_GROUP}
USB_STRINGS_DIR=${USB_CONFIGFS_DIR}/strings/${USB_ATTRIBUTE}
USB_FUNCTIONS_DIR=${USB_CONFIGFS_DIR}/functions
USB_CONFIGS_DIR=${USB_CONFIGFS_DIR}/configs/${USB_SKELETON}

configfs_init()
{
	mountpoint -q ${CONFIGFS_DIR} || mount -t configfs none ${CONFIGFS_DIR}
	mkdir -p ${USB_CONFIGFS_DIR} -m 0770
	echo 0x2207 > ${USB_CONFIGFS_DIR}/idVendor
	echo 0x0011 > ${USB_CONFIGFS_DIR}/idProduct
	echo 0x0310 > ${USB_CONFIGFS_DIR}/bcdDevice
	echo 0x0200 > ${USB_CONFIGFS_DIR}/bcdUSB

	mkdir -p ${USB_STRINGS_DIR} -m 0770
	SERIAL=$(grep Serial /proc/cpuinfo 2>/dev/null | awk '{print $3}')
	[ -z "$SERIAL" ] && SERIAL=0123456789ABCDEF
	echo "$SERIAL" > ${USB_STRINGS_DIR}/serialnumber
	echo "rockchip" > ${USB_STRINGS_DIR}/manufacturer
	echo "Luckfox Pico Composite" > ${USB_STRINGS_DIR}/product

	mkdir -p ${USB_FUNCTIONS_DIR}/ncm.gs0
	mkdir -p ${USB_FUNCTIONS_DIR}/acm.video0
	mkdir -p ${USB_FUNCTIONS_DIR}/acm.telemetry0

	mkdir -p ${USB_CONFIGS_DIR} -m 0770
	mkdir -p ${USB_CONFIGS_DIR}/strings/${USB_ATTRIBUTE} -m 0770
}

bind_functions()
{
	USB_FUNCTIONS_CNT=1
	[ "$NCM_EN" = "on" ] && { ln -sf ${USB_FUNCTIONS_DIR}/ncm.gs0 ${USB_CONFIGS_DIR}/f${USB_FUNCTIONS_CNT}; USB_FUNCTIONS_CNT=$((USB_FUNCTIONS_CNT+1)); }
	if [ "$ACM_EN" = "on" ]; then
		ln -sf ${USB_FUNCTIONS_DIR}/acm.video0 ${USB_CONFIGS_DIR}/f${USB_FUNCTIONS_CNT}
		USB_FUNCTIONS_CNT=$((USB_FUNCTIONS_CNT+1))
		ln -sf ${USB_FUNCTIONS_DIR}/acm.telemetry0 ${USB_CONFIGS_DIR}/f${USB_FUNCTIONS_CNT}
		USB_FUNCTIONS_CNT=$((USB_FUNCTIONS_CNT+1))
	fi
	echo "ncm_acm" > ${USB_CONFIGS_DIR}/strings/${USB_ATTRIBUTE}/configuration
}

run_binary()
{
	sleep 1
	ifconfig usb0 172.32.0.93 netmask 255.255.0.0 up 2>/dev/null || true
}

usb_device_stop()
{
	echo "none" > ${USB_CONFIGFS_DIR}/UDC 2>/dev/null || true
	rm -f ${USB_CONFIGS_DIR}/f* 2>/dev/null || true
}

case "$1" in
start)
	ifconfig lo up 2>/dev/null || true
	configfs_init
	bind_functions
	UDC=$(ls /sys/class/udc/ 2>/dev/null | awk '{print $1}')
	[ -z "$UDC" ] && UDC="ffb00000.usb"
	echo "$UDC" > ${USB_CONFIGFS_DIR}/UDC 2>/dev/null || true
	run_binary
	;;
stop)
	usb_device_stop
	;;
restart|reload)
	usb_device_stop
	sleep 1
	$0 start
	;;
*)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac
exit 0